# Copy to .env and fill in. Never commit .env.

# GitHub token (no scopes needed for public repos). Raises the API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
# Shared secret for POST /webhooks/github (set the same value in the repo's webhook settings).
GITHUB_WEBHOOK_SECRET=

# LLM: groq (default) | openai | anthropic
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings: local (bge-small-en-v1.5, free) | openai (text-embedding-3-small @ 384 dims) | hash (tests only)
EMBEDDING_PROVIDER=local

# Running the API/worker outside Docker against the compose services:
DATABASE_URL=postgresql://repochat:repochat@localhost:5432/repochat
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Limits
MAX_FILES=2000
MAX_TOTAL_BYTES=52428800
WORKER_CONCURRENCY=1
RATE_LIMIT_INDEX_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=30
CORS_ORIGINS=http://localhost:3000

# Newer LocalStack images need a (free) auth token; the pinned 3.8 image does not.
LOCALSTACK_AUTH_TOKEN=
